# Copied to $MCP_SECRETS_DIR/gmx.env (mode 600) by `./mcp init`. Never commit the real file.
# Only identity and credentials belong here; the safety policy lives in
# servers/gmx/compose.yaml and overrides anything set in this file.
MCP_EMAIL_SERVER_EMAIL_ADDRESS=you@gmx.de
MCP_EMAIL_SERVER_USER_NAME=you@gmx.de
MCP_EMAIL_SERVER_FULL_NAME=Your Name
# GMX app-specific password (Mein Account -> Sicherheit -> Anwendungsspezifische Passwörter)
MCP_EMAIL_SERVER_PASSWORD=
